
<div class="modal fade" data-name="GenericModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="viewPaymentsModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-md modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="infoTitle"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding-bottom:0!important;">
            </div>
        </div>
    </div>
</div>
<div class="modal" data-name="ModalConfirmation" tabindex="-1" style="z-index:1210;" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" data-name="ModalConfirmationTitle"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-name="ModalConfirmationCancel" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p data-name="ModalConfirmationMessageBody"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" data-name="ModalConfirmationOK">Yes</button>
                <button type="button" class="btn btn-primary btn-sm" data-name="ModalConfirmationCancel" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" data-name="ModalMessage" tabindex="-1" style="z-index:1200;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-name="ModalMessageTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" data-name="ModalMessageCancel"></button>
            </div>
            <div class="modal-body">
                <p data-name="ModalMessageBody"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-name="ModalMessageOk" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>

