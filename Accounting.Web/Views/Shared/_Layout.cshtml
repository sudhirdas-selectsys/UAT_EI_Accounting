<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expert Insured Accounting</title>
    <link rel="shortcut icon" type="images/x-icon" href="~/images/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
          rel="stylesheet">
    <script type="text/javascript">
        var MasterLookup = JSON.parse('@Html.Raw(Json.Serialize(new MasterLookupDynamic()))');
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/lib/custom/bootstrap-datetimepicker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
    <script src="~/js/utility.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="~/js/grid-sorter.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/grid-sorter.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

    <!-- jQuery and jQuery UI JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="~/lib/custom/moment.min.js"></script>
    <script src="~/lib/custom/bootstrap-datetimepicker.min.js"></script>
    <script src="~/js/systemconfiguration.js" asp-append-version="true"></script>
</head>
<body>
    @{
        UserSession userSession = Context.Session.GetObjectFromJson<UserSession>("UserSession");
    }
    <div class="wrapper">
        <div class="page-right-section">
            <div data-name="HeaderPanel">
                @{
                    Html.RenderPartial("_HeaderPanel.cshtml", userSession);
                }
            </div>
            <div data-name="MainContent">
                <div class="main-content innerpages">
                    <div class="container-fluid">
                        <div class="classic-spinner invisible">
                            <div class="spinner-border loader-primary" role="status"> <span class="visually-hidden">Loading...</span> </div>
                        </div>
                        <div id="maincontent">
                            @RenderBody()
                        </div>
                        <input type="hidden" data-name="Client_Id" name="Client_Id" value="@userSession.Client_Id" />
                    </div>
                </div>
                <div class="page-footer"> &copy; @DateTime.Now.Year Powered by <a href="https://www.selectsystech.com/" target="_blank"> SelectsysTech</a></div>
            </div>
        </div>
    </div>
    @{
        Html.RenderPartial("ModalComponents.cshtml");
    }
    <div class="invisible" data-name="PartialPanelLoader" style="left:50%;top:50%;position:absolute;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <div class="invisible" data-name="OffcanvasLoader" style="left:50%;top:50%;position:absolute;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <div class="fab-container">
        <div class="fab shadow">
            <div class="fab-content"> <i class="ri-menu-4-line"></i> </div>
        </div>
        <div class="sub-button shadow"> <a href="/" title="Dashboard"> <i class="ri-dashboard-line"></i> </a> </div>
        <div class="sub-button shadow"> <a href="javascript:void(0)" title="Add Payments" data-name="btnAddPaymentDetails" aria-controls="addPaymentPlan"><i class="ri-money-dollar-circle-line"></i> </a> </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <script type="text/javascript">
        var LoadPartialPanel = true;
        @{
            if (ViewBag.LoadPartialPanel != null && !ViewBag.LoadPartialPanel)
            {
                <text>LoadPartialPanel =false; </text>
            }
        }
    </script>
</body>
</html>
