@using Accounting.Entities.DB.Lookups;
@model List<LU_PaymentPlans>;
@{
	var PageSize = ViewBag.PageSize;
	var PageNumber = ViewBag.PageNumber;
	var TotalRecords = ViewBag.TotalRecords;
	int TotalPages = (int)Math.Ceiling((double)TotalRecords / PageSize);
	UserSession userSession = Context.Session.GetObjectFromJson<UserSession>("UserSession");
}

<style>
	.cta-buttons {
		top: -25px;
		width: 98%;
	}

	td input.form-control {
		display: none;
	}

	td .label {
		display: block;
		color: #495057;
		font-size: 13px;
	}

	#addInstallmentPlan .data-item label {
		margin-bottom: 4px;
	}

	#addInstallmentPlan .data-item {
		padding-top: 0;
	}

	#addInstallmentPlan .form-switch .form-check-input {
		height: 20px;
		width: 40px;
	}

	.offcanvas.offcanvas-end {
		z-index: 9999;
	}

	#addInstallmentPlan .form-check-input.unchecked:not(:checked) {
		background-color: #efa22d;
		border-color: #efa22d;
	}

	.form-check-input:checked {
		background-color: #5F2EE5;
		border-color: #5F2EE5;
	}

	.downPaymentPercent {
		padding-left: 43px;
		position: relative;
	}


		.downPaymentPercent:before {
			content: "%";
			width: 42px;
			height: 42px;
			position: absolute;
			left: 0;
			background-color: #F8F9FA;
			line-height: 42px;
			text-align: center;
			border-top-left-radius: 0.375rem;
			border-bottom-left-radius: 0.375rem;
			border: 1px solid #dee2e6;
			border-right: none;
		}

	.form-floating.downPaymentPercent > .form-control ~ label {
		margin-left: 52px;
	}

	.downPaymentMin:before {
		content: "$";
	}

	.form-floating.downPaymentPercent .form-control {
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
	}

	.downPaymentPercent .field-validation-error {
		margin-left: -43px;
	}

	.installment-filters .code-input {
		max-width: 120px !important;
	}

	.installment-filters .nop-input {
		max-width: 150px !important;
	}

	.installment-filters .modal-link {
		min-width: 80px !important;
	}
</style>

<form class="form">
	<div class="card position-relative">
		<div class="card-body">
			<div class="cta-buttons installment-filters">
				<div class="row align-items-center g-2 mb-3">
					<div class="col-md-4 col-lg-4 col-xl-3 m-0">
						<h1 class="section-heading" data-name="lblInstallmentPlanPageName"></h1>
					</div>
					<div class="col-md-8 col-lg-8 col-xl-9 m-0">
						<div class="d-flex gap-2 flex-md-row flex-lg-row flex-column">
							<!-- Search Input -->

							<input type="text" class="form-control" autocomplete="off" data-name="txtInstallmentPlanName" placeholder="Name">
							<input type="text" class="form-control code-input" autocomplete="off" data-name="txtInstallmentPlanCode" placeholder="Code">
							<input type="text" class="form-control nop-input" autocomplete="off" data-name="txtInstallmentPlanNumberOfPayments" placeholder="Number of Payments">
							<input type="text" class="form-control" autocomplete="off" data-name="txtInstallmentPlanCarrier" placeholder="Carrier">

								<button class="btn btn-primary" type="button" title="Search" data-name="btnInstallmentPlanSearch">
									<i class="ri-search-2-line"></i>
								</button>
							

							<a class="btn btn-primary addnewbtn modal-link" role="button" data-name="btnAddInstallmentPlan" href="javascript:void(0)"></a>

							<!-- Dropdown for Suggestions -->
							<ul class="search-suggestions" style="display: none; position: absolute; background: #fff; border: 1px solid #ccc; width: 100%; z-index: 100;">
								<li>Hello</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="w-100 pb-2 pt-0">
				<div class="table-responsive table-scroll payment-table" style="height: calc(100vh - 272px);">
					<table class="table table-striped ei-table text-nowrap">
						<thead>
							<tr>
								<th>S.No </th>
								<th>Name </th>
								<th>Code </th>
								<th>Number Of Payments </th>
								<th>Carrier</th>
								<th>Actions </th>
							</tr>
						</thead>
						<tbody>
							@{
								if (Model?.Count > 0)
								{
									int Index = 1;
									@foreach (var item in Model)
									{
										<tr>
											<td>@Index</td>
											<td><label class="label">@item?.Name</label></td>
											<td><label class="label">@item?.Code</label></td>
											<td><label class="label">@item?.NumberOfPayments</label></td>
											<td><label class="label">@item?.CarrierName</label></td>
											<td valign="middle">
												<div class="action-btns">
													<a href="javascript:void(0)" data-name="btnEditInstallmentPlan" data-installmentplan-id="@item?.PaymentPlan_Id">
														<i class="ri-pencil-line save-btn edit-btn"></i>
													</a>
													<a href="javascript:void(0)" data-name="btnDeleteInstallmentPlan" data-installmentplan-id="@item?.PaymentPlan_Id"> <i class="ri-delete-bin-6-line text-danger delete-btn" title="delete"></i> </a>
												</div>

											</td>
										</tr>
										Index++;
									}
								}
								else
								{
									<tr><td colspan="51">No records found!</td></tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div class="card-footer bg-white border-0 text-center px-3">
			<div class="d-flex justify-content-between tbl-pagination me-4">
				<div class="select-per-page">
					<span>Showing</span>
					@{
						List<int> pageSizeOptions = new List<int> { 50,100,200 };
					}
					<select class="form-select" data-name="PageSize" data-table-name="InstallmentPlan">
						@foreach (var size in pageSizeOptions)
						{
							<!option value="@size" @(PageSize == size ? "selected" : "")>@size</!option>
						}
					</select>
				</div>

				<ul class="pagination justify-content-end">
					<li class="page-item"> <a class="page-link" tabindex="-1" aria-disabled="true" value="@PageSize+''+@PageNumber+''+@TotalPages" data-table-name="InstallmentPlan" data-name="btnPrevious"><i class="ri-arrow-left-s-line"></i></a> </li>
					@for (int i = 1; i <= TotalPages; i++)
					{
						<li class="page-item @(@PageNumber==i?"active":"")">
							<a class="page-link" href="#" data-table-name="InstallmentPlan" data-name="btnPageNumber" data-page="@i+''+@PageSize">
								@i
							</a>
						</li>
					}
					<li class="page-item"> <a class="page-link" data-table-name="InstallmentPlan" data-name="btnNext" value="@PageSize+''+@PageNumber+''+@TotalPages"><i class="ri-arrow-right-s-line"></i></a> </li>
				</ul>
			</div>
		</div>
		@* </div> *@
	</div>
</form>
<link href="~/css/skeleton.css" rel="stylesheet" />
<script src="~/js/systemconfiguration.js" asp-append-version="true"></script>
<script>
	setTimeout(() => {
	  $('.animate, .animate-modal').hide()
	}, 1000);
	$('.modal-link').on("click", function () {
	  $('.animate-modal').show()
	  setTimeout(() => {
		$('.animate-modal').hide()
	  }, 1000);
	});

</script>
<script type="text/javascript">
	$(document).ready(function () {

	$('#leadTimeContainer').toggle(!$('#setDate').is(':checked'));

	$('#setDate').change(function(){
	  $('#leadTimeContainer').toggle(!$(this).is(':checked'));
	});

	});
</script>
