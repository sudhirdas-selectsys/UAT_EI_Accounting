    //var $firstTab = $('[data-name="btntab"]').first();
    var $configContainer = $('[data-name="ConfigurationTabContainer"]');
    var noAccessHtml = '<p class="text-center">You don’t have access to manage any configurations at this time. Please contact admin.</p>';


     function selectFirstTab() {
     var $firstTab = $('[data-name="btntab"]:visible').first();
    if ($firstTab.length > 0) {
      // Found a tab — simulate click to activate it
      $firstTab.trigger('click');
       //$clientTabs.first().trigger('click');
    } else {
      // No tab found — show/hide message depending on nav-pills present
      var visibleNavPills = $('.nav-pills:visible');
      if (visibleNavPills.length === 0) {
        // No nav-pills visible → show message
        $configContainer.html(noAccessHtml);
      } else {
        // Nav-pills present but no tab → clear container
        $configContainer.empty();
      }
    }
    }
    selectFirstTab();

    });
</script>
