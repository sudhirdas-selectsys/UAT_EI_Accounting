@using Accounting.Entities.DB.Lookups;
@model List<LU_OperatingBanks>;
@{
	var PageSize = ViewBag.PageSize;
	var PageNumber = ViewBag.PageNumber;
	var TotalRecords = ViewBag.TotalRecords;
	int TotalPages = (int)Math.Ceiling((double)TotalRecords / PageSize);
	var Client_Id = ViewBag.Client_Id != null ? ViewBag.Client_Id : 0;
	int Service_Id = ViewBag.Service_Id != null ? Convert.ToInt32(ViewBag.Service_Id) : 0;
	int PaymentService_Id = ViewBag.PaymentService_Id != null ? Convert.ToInt32(ViewBag.PaymentService_Id) : 0;

	bool showCOAColumn =
		Service_Id == MasterLookup._Services.Intuit ||
		Service_Id == MasterLookup._Services.Sage;
	bool showOverrideDefaultColumn = PaymentService_Id > 0;
}
<style>
	.cta-buttons {
		top: -25px;
		width: 98%;
	}
</style>
<form class="form">
	<div class="card position-relative">
		<div class="card-body">
			<div class="cta-buttons">
				<div class="row align-items-center g-2 mb-3">
					<div class="col-md-4 col-lg-4 col-xl-6 m-0">
						<h1 class="section-heading" data-name="lblPageName"></h1>
					</div>
					<div class="col-md-8 col-lg-8 col-xl-6 m-0">
						<div class="d-flex justify-content-end gap-3 flex-md-row flex-lg-row flex-column">
							<!-- Search Input -->
							<div class="input-group tablet-max-180">
								<input type="text" class="form-control" autocomplete="off" data-name="txtSearch">
								<button class="btn btn-primary" type="button" title="Search" data-name="btnSearch"> <i class="ri-search-2-line"></i></button>
							</div>
							<a class="btn btn-primary addnewbtn" role="button" data-name="btnAddBank" href="javascript:void(0)"></a>
							<!-- Dropdown for Suggestions -->
							<ul class="search-suggestions" style="display: none; position: absolute; background: #fff; border: 1px solid #ccc; width: 100%; z-index: 100;">
								<li>Hello</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="w-100 pb-2 pt-0">
				<div class="table-responsive table-scroll payment-table" style="height: calc(100vh - 272px);">
					<table class="table table-striped ei-table text-nowrap">
						<thead>
							<tr>
								<th>S.No </th>
								<th>Name </th>
								<th>Code </th>
								@if (showCOAColumn)
								{
									<th>Chart of Account </th>
								}

								<th>Actions </th>
								@if (showOverrideDefaultColumn)
								{
									<th width="10%" class="text-center">Default Payment Account</th>
								}
							</tr>
						</thead>
						<tbody>
							@{
								if (Model?.Count > 0)
								{
									int Index = 1;
									@foreach (var item in Model)
									{
										<tr>
											<td>@Index</td>
											<td><label class="label">@item?.Name</label></td>
											<td><label class="label">@item?.Code</label></td>
											@if (showCOAColumn)
											{
												<td><label class="label">@LookupUtility.GetAllChartofAccounts()?.Where(c => c.Client_Id == item?.Client_Id && c.Service_Id == item.Service_Id && c.ChartOfAccounts_Id == item?.OperatingBankCOA_Id)?.FirstOrDefault()?.Name</label></td>
											}

											<td valign="middle">
												<div class="action-btns">
													<a href="javascript:void(0)" data-name="btnEditOperatingBank" data-operatingbank-id="@item?.OperatingBank_Id">
														<i class="ri-pencil-line save-btn edit-btn"></i>
													</a>
													<a href="javascript:void(0)" data-name="btnDeleteOperatingBank" data-operatingbank-id="@item?.OperatingBank_Id"> <i class="ri-delete-bin-6-line text-danger delete-btn" title="delete"></i> </a>

												</div>

											</td>
											@if (showOverrideDefaultColumn)
											{
												<td>
													<div class="role-container">
														<div class="form-check form-switch m-0">
															<input class="form-check-input company-radio" data-name="rdnDefaultPaymentOperatingBank" data-operatingbank-id="@item?.OperatingBank_Id" @(item?.DefaultPaymentOperatingBank == true ? "checked data-default=true" : "") type="radio" name="role" value="">
														</div>
													</div>
												</td>
											}

										</tr>
										Index++;
									}
								}
								else
								{
									<tr><td colspan="51">No records found!</td></tr>
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div class="card-footer bg-white border-0 text-center px-3">
			<div class="d-flex justify-content-between tbl-pagination me-4">
				<div class="select-per-page">
					<span>Showing</span>
					@{
						List<int> pageSizeOptions = new List<int> { 5, 10, 15, 20, 30 };
					}
					<select class="form-select" data-name="PageSize" data-table-name="OperatingBanks">
						@foreach (var size in pageSizeOptions)
						{
							<!option value="@size" @(PageSize == size ? "selected" : "")>@size</!option>
						}
					</select>
				</div>

				<ul class="pagination justify-content-end">
					<li class="page-item"> <a class="page-link" tabindex="-1" aria-disabled="true" value="@PageSize+''+@PageNumber+''+@TotalPages" data-table-name="OperatingBanks" data-name="btnPrevious"><i class="ri-arrow-left-s-line"></i></a> </li>
					@for (int i = 1; i <= TotalPages; i++)
					{
						<li class="page-item @(@PageNumber==i?"active":"")">
							<a class="page-link" href="#" data-table-name="OperatingBanks" data-name="btnPageNumber" data-page="@i+''+@PageSize">
								@i
							</a>
						</li>
					}
					<li class="page-item"> <a class="page-link" data-table-name="OperatingBanks" data-name="btnNext" value="@PageSize+''+@PageNumber+''+@TotalPages"><i class="ri-arrow-right-s-line"></i></a> </li>
				</ul>
			</div>
		</div>
		@* </div> *@
	</div>
</form>
<script src="~/js/systemconfiguration.js" asp-append-version="true"></script>
