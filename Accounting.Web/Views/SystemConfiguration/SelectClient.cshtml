@model List<Clients>
@{
	UserSession userSession = Context.Session.GetObjectFromJson<UserSession>("UserSession");
}

<div class="role-container scrollable-dropdown" data-name="divClientList">
	@if (Model.Count > 0)
	{
		foreach (var item in Model)
		{
			<div class="d-flex align-items-center justify-content-between mb-1">
				<div class="dropdown-item @(item.Client_Id == userSession?.ConfigurationClient_Id ? "active-company" : "")">
					<div class="d-flex align-items-center company-select w-100" data-name="divSelectClient" data-client-id="@item.Client_Id" style="cursor: pointer;">
						<span class="company-name">@item.CompanyName</span>
					</div>
				</div>
			</div>
		}
	}
	else
	{
		<div class="dropdown-item text-muted">No companies found</div>
	}
</div>

<style>
	.c-logo {
		width: 36px;
		height: 36px;
		background-color: #6a44f1;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		color: #fff;
		font-size: 14px;
	}
</style>