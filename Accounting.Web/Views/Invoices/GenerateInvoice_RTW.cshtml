@using Newtonsoft.Json
@model PolicyDetails
@{
    var Clients = Model.Clients;
    var AgentDetails = Model.AgentDetails;
    var CarrierDetails = Model.CarrierDetails;
    var InsuredDetails = Model.InsuredDetails;
    var WholesalerDetails = Model.WholesalerDetails;
    var BillingType_Id = LookupUtility.GetAllBillingTypes().FirstOrDefault(x => x.Code == Model.BillType)?.BillingType_Id;
    var MortgageeDetails = Model.MortgageeDetails;
    var PolicyDetails_Id = Model.Id;
    var InstallmentNo = Model?.InstallmentNo;
    var minPremium = Model.PolicyDetailsLineItemsList
                    .Where(x => x.LineType != null && x.LineType.Equals("Premium", StringComparison.OrdinalIgnoreCase))
                    .Select(x => (double?)x.MinPremium)
                    .FirstOrDefault();
    var PaymentDueOn = LookupUtility.GetClientSettings(Clients.Client_Id, MasterLookup._ClientSettings.InvoicePaymentDueOn);
    bool Is_Installment = Model?.InvoicesList.Count() > 1;
    var paymentLink = LookupUtility.GetClientSettings(Clients.Client_Id, MasterLookup._ClientSettings.InvoicePaymentFooter);
    var accountNumber = AgentDetails?.EI_Accounting_Id ?? @Model?.ExternalAccountInformation?.AccountNumber ?? string.Empty;
    var postalCode = BillingType_Id switch
    {
        var x when x == MasterLookup._BillingTypes.Agency
            => AgentDetails?.ZipCode ?? string.Empty,

        var x when x == MasterLookup._BillingTypes.Insured
            => InsuredDetails?.ZipCode ?? string.Empty,

        var x when x == MasterLookup._BillingTypes.Mortgagee
            => MortgageeDetails?.ZipCode ?? string.Empty,

        _ => string.Empty
    };
    string dynamicURL = string.Format(paymentLink, accountNumber, postalCode);
}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;background:#ffffff;font-size:13px;">
    <tbody>
        <tr>
            <td width="100%" style="padding:20px;">
                <table width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tbody>

                        <tr>
                            @{
                                string base64Image = Clients != null ? Convert.ToBase64String(Clients.Logo) : "";
                                string imgSrc = !string.IsNullOrEmpty(base64Image) ? $"data:image/jpg;base64,{base64Image}" : "";
                            }
                            <td style="color:#fff;font-size:18px;font-weight:600;font-family:Arial, sans-serif;">
                                <img src="@imgSrc" alt="Logo" border="0" width="250">
                            </td>
                        </tr>
                        <tr>
                            <td height="5"></td>
                        </tr>
                        <tr>
                            <td style="color:#333;font-size:12px;font-family:Arial, sans-serif;color: #333;font-size: 13px;vertical-align: top;border-bottom:2px solid #000;">
                                <div>
                                    14001 Dallas Parkway, Suite 700, Dallas, TX 75240
                                </div>
                                <div style="height:5px;"></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <!-- HEADER -->
        <tr>
            <td style="padding:20px;padding-top:0;">

                <table width="100%" cellpadding="0" cellspacing="0" border="0">

                    <tbody>
                        <tr>
                            <td align="right" style="font-family:Arial, Helvetica, sans-serif;font-size:28px;font-weight:bold;color:#004a87;letter-spacing:8px;padding-bottom:10px;">
                                @{
                                    var InvoiceName = Is_Installment ? "INSTALLMENT INVOICE" : "INVOICE";
                                }
                                @Html.Raw(InvoiceName)
                            </td>
                        </tr>
                        <tr>
                            <td align="right" style="font-family:Arial, Helvetica, sans-serif;font-size:12px;color:#555555;padding-bottom:10px;">
                                Invoice# @Model?.Invoices?.InvoiceNo | &nbsp;&nbsp;
                                Date: @Model?.Invoices?.BillDate.ToString(MasterLookup._ServerDateFormat)
                            </td>
                        </tr>
                        <tr>
                            @{
                                double totalAmountDue = 0;
                                double Actualamount = 0;
                                if (Model?.InvoicesList?.Count > 0)
                                {
                                    var invoiceList = Model?.InvoicesList.Where(x => x.InstallmentNo == InstallmentNo).ToList();
                                    if (invoiceList != null)
                                    {
                                        foreach (var invoice in invoiceList)
                                        {
                                            totalAmountDue += Convert.ToDouble(invoice.RemainingBalance);
                                            Actualamount += Convert.ToDouble(invoice.Amount);
                                        }
                                    }
                                }
                            }

                            <td align="right" style="font-family:Arial, Helvetica, sans-serif;font-size:13px;font-weight:bold;color:#004a87;">
                                @{
                                    string dueName;
                                    if (!Is_Installment)
                                    {
                                        dueName = "Due Amount:";
                                    }
                                    else if (Model?.InstallmentNo == 0)
                                    {
                                        dueName = "Installment Down Payment Due Amount:";
                                    }
                                    else
                                    {
                                        var suffix = Model?.InstallmentNo switch
                                        {
                                            1 => "st",
                                            2 => "nd",
                                            3 => "rd",
                                            _ => "th"
                                        };

                                        dueName = $"{Model?.InstallmentNo}<sup>{suffix}</sup> Installment Due Amount:";
                                    }
                                }
                                @Html.Raw(dueName)
                                <span style="color:#004a87;">
                                    @CommonUtility.ConvertToCurrencyFormat(totalAmountDue, false, 2)
                                </span>
                                &nbsp; | &nbsp;&nbsp;
                                Due Date: @Model?.Invoices?.DueDate.ToString(MasterLookup._ServerDateFormat)
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

        <!-- DIVIDER -->
        <tr>
            <td style="padding:0 20px;">
                <table width="100%" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td style="border-top:1px solid #4b4b4b;font-size:1px;line-height:1px;">&nbsp;</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

        <!-- BILLING ADDRESSES -->
        <tr>
            <td style="padding:18px 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td style="font-size:14px;font-weight:bold;color:#004f90;letter-spacing:4px;">
                                <div style="padding-bottom:4px;">Bill To :</div>
                            </td>

                        </tr>
                        <tr>
                            @{
                                if (MortgageeDetails != null && BillingType_Id == MasterLookup._BillingTypes.Mortgagee)
                                {
                                    <td width="33%" valign="top">
                                        <table width="100%">
                                            <tbody>
                                                <tr>
                                                    <td style="font-size:10px;font-weight:bold;color:#777;letter-spacing:4px;color:#777;">
                                                        MORTGAGEE
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="font-size:12px;color:#222;padding-top:4px;line-height:18px;">
                                                        @MortgageeDetails?.Name<br>
                                                        @MortgageeDetails?.Address1<br>
                                                        @MortgageeDetails?.City, @MortgageeDetails?.State @MortgageeDetails?.ZipCode
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                }
                            }
                            <td width="33%" valign="top">
                                <table width="100%">
                                    <tbody>
                                        <tr>
                                            <td style="font-size:10px;font-weight:bold;color:#777;letter-spacing:4px;color:#777;">
                                                INSURED
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="font-size:12px;color:#222;padding-top:4px;line-height:18px;">
                                                @InsuredDetails?.Name<br>
                                                @if (!string.IsNullOrEmpty(@InsuredDetails?.Address2))
                                                {
                                                    @("c/o " + InsuredDetails.Address2)

                                                    <br />
                                                }
                                                @InsuredDetails?.Address1<br>
                                                @InsuredDetails?.City, @InsuredDetails?.State @InsuredDetails?.ZipCode
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>

                            <td width="33%" valign="top">
                                <table width="100%">
                                    <tbody>
                                        <tr>
                                            <td style="font-size:10px;font-weight:bold;color:#777;letter-spacing:4px;color:#777;">
                                                PRODUCER
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="font-size:12px;color:#222;padding-top:4px;line-height:18px;">
                                                @AgentDetails?.Name<br>
                                                @AgentDetails?.Address1<br>
                                                @AgentDetails?.City, @AgentDetails?.State @AgentDetails?.ZipCode
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

        <!-- POLICY INFORMATION -->
        <tr>
            <td style="padding:0 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td style="font-size:14px;font-weight:bold;color:#004f90;letter-spacing:4px;border-bottom:1px solid #333;">
                                <div style="padding-bottom:4px;">POLICY INFORMATION</div>
                            </td>

                        </tr>


                    </tbody>
                </table>
            </td>
        </tr>

        <tr>
            <td style="padding:18px 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td width="33%" style="font-size:12px;padding-bottom:8px;"><strong>Policy Number:</strong></td>
                            <td width="67%" style="font-size:12px;padding-bottom:8px;">@Model?.PolicyNumber</td>
                        </tr>

                        <tr>
                            <td style="font-size:12px;padding-bottom:8px;"><strong>Policy Term:</strong></td>
                            <td style="font-size:12px;padding-bottom:8px;">@Model?.EffectiveDate.ToString(MasterLookup._ServerDateFormat) - @Model?.ExpirationDate.ToString(MasterLookup._ServerDateFormat)</td>
                        </tr>

                        <tr>
                            <td style="font-size:12px;padding-bottom:8px;"><strong>Coverage:</strong></td>
                            <td style="font-size:12px;padding-bottom:8px;">@Model?.PolicyDetailsLineItemsList?.FirstOrDefault()?.Coverage</td>
                        </tr>

                        <tr>
                            <td style="font-size:12px;"><strong>Carrier:</strong></td>
                            <td style="font-size:12px;">@CarrierDetails?.Name</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <!-- CHARGE DETAILS -->
        <tr>
            <td style="padding:0 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td style="font-size:14px;font-weight:bold;color:#004f90;letter-spacing:4px;border-bottom:1px solid #333;">
                                <div style="padding-bottom:4px;">CHARGE DETAILS</div>
                            </td>

                        </tr>


                    </tbody>
                </table>
            </td>
        </tr>
        <tr height="15">
        </tr>
        <tr>
            <td style="padding:16px 20px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tbody style="border:solid black 1px;">
                        <tr bgcolor="#004f90">
                            <td style="padding:8px;color:#fff;font-size:12px;font-weight:bold;">
                                Description
                            </td>

                            <td align="right" style="padding:8px;color:#fff;font-size:12px;font-weight:bold;">
                                Amount
                            </td>
                        </tr>
                        @{
                            bool alternateRow = false;
                            if (!Is_Installment)
                            {
                                @if (Model?.PolicyDetailsLineItemsList?.Count > 0)
                                {
                                    foreach (var item in Model.PolicyDetailsLineItemsList)
                                    {
                                        // PREMIUM
                                        if (item.LineType != null && item.LineType.Contains("PREMIUM", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <tr>
                                                <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    Premium - @Model.TransactionType - @item.Coverage
                                                </td>

                                                <td align="right"
                                                    style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    @CommonUtility.ConvertToCurrencyFormat(item.Premium, false, 2)
                                                </td>
                                            </tr>

                                            alternateRow = !alternateRow;

                                            // COMMISSION
                                            @* if (item.CommissionAmount > 0)
                                        {
                                            <tr>
                                                <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    Commission Credit @item.HouseCommission% - @item.Coverage
                                                </td>

                                                <td align="right"
                                                    style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    @CommonUtility.ConvertToCurrencyFormat(item.HouseCommission, false, 2)
                                                </td>
                                            </tr>

                                            alternateRow = !alternateRow;
                                        } *@

                                        }

                                        // TAX / FEES
                                        if (item.FeeTaxAmount != 0)
                                        {
                                            <tr>
                                                <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    @item.PolicyDetailDescription
                                                </td>

                                                <td align="right"
                                                    style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                    @CommonUtility.ConvertToCurrencyFormat(item.FeeTaxAmount, false, 2)
                                                </td>
                                            </tr>

                                            alternateRow = !alternateRow;
                                        }
                                    }
                                }
                            }
                            else
                            {

                                if (Model?.InvoicesList?.Count > 0)
                                {
                                    var invoiceList = Model?.InvoicesList.Where(x => x.InstallmentNo == InstallmentNo).ToList();
                                    if (invoiceList != null)
                                    {
                                        foreach (var invoice in invoiceList)
                                        {
                                            foreach (var item in invoice.InvoicesDetailsList.GroupBy(x => x.Description).Select(g => g.First()))
                                            {
                                                //PREMIUM
                                                if (!string.IsNullOrEmpty(item.LineTypeName) && item.LineTypeName.Contains("PREMIUM", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <tr>
                                                        <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                            @item.Description
                                                        </td>

                                                        <td align="right"
                                                            style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                            @CommonUtility.ConvertToCurrencyFormat(item.ActualPremium, false, 2)
                                                        </td>
                                                    </tr>

                                                    alternateRow = !alternateRow;
                                                }

                                                //TAX / FEES
                                                if (!string.IsNullOrEmpty(item.LineTypeName) && (item.LineTypeName.Equals("TAX", StringComparison.OrdinalIgnoreCase) || item.LineTypeName.Equals("Fee", StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <tr>
                                                        <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                            @item.Description
                                                        </td>

                                                        <td align="right"
                                                            style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                                            @CommonUtility.ConvertToCurrencyFormat(item.Amount, false, 2)
                                                        </td>
                                                    </tr>

                                                    alternateRow = !alternateRow;
                                                }
                                            }
                                        }
                                    }

                                }
                            }
                            <tr>
                                <td style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                    Amount Paid
                                </td>
                                <td align="right"
                                    style='padding:8px;border-bottom:1px solid #ddd;font-size:12px;@(alternateRow ? "background-color:#f7f7f7;" : "")'>
                                    @CommonUtility.ConvertToCurrencyFormat(Model?.TotalAppliedAmount, false, 2)
                                </td>
                            </tr>
                        }
                        <tr>
                            <td style="padding:10px;font-size:13px;font-weight:bold;">Total Due  @Model?.Invoices?.DueDate.ToString(MasterLookup._ServerDateFormat):</td>
                            <td align="right" style="padding:10px;font-size:13px;font-weight:bold;">@CommonUtility.ConvertToCurrencyFormat(totalAmountDue, false, 2)</td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

        <!-- PAYMENT OPTIONS -->
        <tr>
            <td style="padding:0 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td style="font-size:14px;font-weight:bold;color:#004f90;letter-spacing:4px;border-top:3px solid #004f90;padding-top:10px;padding-bottom:8px;">
                                PAYMENT OPTIONS
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

        <tr>
            <td style="padding:10px 20px 20px;">

                <table width="100%" cellpadding="0" cellspacing="0"
                       border="0"
                       style="table-layout:fixed;border-collapse:collapse;border:1px solid #b6b6b6;">

                    <thead>
                        <tr>
                            <th colspan="2"
                                style="border:1px solid #b6b6b6;padding:8px 6px;font-size:13px;color:#004f90;text-align:center;">
                                Please make all checks payable to Risk Theory Insurance Services
                                and follow the below mailing instructions
                            </th>

                            <th style="border:1px solid #b6b6b6;padding:8px 6px;font-size:13px;color:#004f90;text-align:center;">
                                ACH / Wire Payment
                            </th>

                            <th style="border:1px solid #b6b6b6;padding:8px 6px;font-size:13px;color:#004f90;text-align:center;">
                                Online Payment
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <!-- REGULAR MAIL -->
                            <td width="25%" valign="top"
                                style="border:1px solid #b6b6b6;">

                                <div style="padding:7px 5px;text-align:center;font-size:13px;font-weight:bold;color:#004f90;border-bottom:1px solid #b6b6b6;">
                                    For Regular U.S. Mail:
                                </div>

                                <div style="padding:12px 7px;font-size:13px;line-height:1.6;text-align:center;">
                                    Risk Theory Insurance Services <b>III</b><br />
                                    PO Box 669609<br />
                                    Dallas, TX 75266-0534
                                </div>
                            </td>

                            <!-- OVERNIGHT DELIVERY -->
                            <td width="25%" valign="top"
                                style="border:1px solid #b6b6b6;">

                                <div style="padding:7px 5px;text-align:center;font-size:13px;font-weight:bold;color:#004f90;border-bottom:1px solid #b6b6b6;">
                                    For Overnight Delivery:
                                </div>

                                <div style="padding:12px 7px;font-size:13px;line-height:1.6;text-align:center;">
                                    Wholesale Lockbox Department<br />
                                    Attn: PO Box 669609<br />
                                    3000 Kellway Dr, Suite 120<br />
                                    Carrollton, TX 75006
                                </div>
                            </td>

                            <!-- ACH / WIRE PAYMENT -->
                            <td width="25%" valign="top"
                                style="border:1px solid #b6b6b6;">

                                <div style="padding:12px 7px;font-size:13px;line-height:1.6;text-align:center;">
                                    Capital One Bank<br /><br />
                                    Account # 208 286 2051<br />
                                    Routing # 065 000 090<br />
                                    Type: Checking
                                </div>
                            </td>

                            <!-- ONLINE PAYMENT -->
                            <td width="25%" valign="top"
                                style="border:1px solid #b6b6b6;">

                                <div style="padding:12px 7px;font-size:13px;line-height:1.6;text-align:center;">
                                    To make an online payment,
                                    please click below link.

                                    <br /><br />

                                    <a href="@dynamicURL"
                                       style="display:inline-block;background:#004f90;color:#fff;text-decoration:none;font-weight:bold;padding:8px 10px;border-radius:4px;font-size:13px;">
                                        Click to Pay Online
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:18px 20px 30px;">
                <div class="modal-footer" style="position: sticky; bottom: 0; background-color: #fff;">
                    <button type="button" class="btn btn-primary" data-policydetails_id=@PolicyDetails_Id data-installmentno=@InstallmentNo data-name="downloadPdf">Get PDF</button>
                </div>
            </td>
        </tr>

        <!-- FOOTER -->
        <tr>
            <td style="padding:20px 20px;">
                <table width="100%">
                    <tbody>
                        <tr>
                            <td style="border-top:1px solid #999;font-size:1px;line-height:1px;">&nbsp;</td>
                        </tr>

                        <tr>
                            <td align="center" style="font-size:10px;color:#999;padding-top:10px;">
                                Risk Theory Insurance Services, LLC |
                                14001 Dallas Parkway, Suite 700,
                                Dallas, TX 75240 |
                                Please remit payment by @Model?.Invoices?.DueDate.ToString(MasterLookup._ServerDateFormat)
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>

    </tbody>
</table>
<style>
    [data-name="GenericModal"] .modal-dialog {
        --bs-modal-width: 1000px !important;
    }

    [data-name="GenericModal"] .modal-body {
        padding: 40px;
    }

    [data-name="GenericModal"] .btn-primary {
        background-color: #004f90 !important;
        border-color: #004f90 !important;
        color: #fff;
    }
</style>
