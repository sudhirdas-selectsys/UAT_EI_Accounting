                                                                </tr>
                                                                <tr>
                                                                    <td style="font-size:22px;color:#222;padding-top:14px;line-height:32px;">
                                                                        @AgentDetails?.Name<br />
                                                                        @AgentDetails?.Address1<br />
                                                                        @AgentDetails?.City, @AgentDetails?.State @AgentDetails?.ZipCode
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                        <table width="100%">
                                            <tbody>
                                                <tr>
                                                    <td style="height:10px;">
                                                    </td>
