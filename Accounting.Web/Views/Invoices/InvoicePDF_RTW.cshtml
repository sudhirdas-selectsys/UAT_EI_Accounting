                                            <tbody>
                                                <tr>
                                                    <td align="right" style="font-family:Arial, Helvetica, sans-serif;font-size:38px;font-weight:bold;color:#004a87;letter-spacing:8px;padding-bottom:10px;">
                                                        @{
                                                            var InvoiceName = Is_Installment ? "INSTALLMENT INVOICE" : "INVOICE";
                                                        }
                                                        @Html.Raw(InvoiceName)
