                                        <div>
                                            <table class="charge-details" width="100%" cellpadding="10" cellspacing="0" border="0">
                                                <tbody>
                                                    <tr>
                                                        <td style="padding:8px;color:#fff;background-color:#004f90;font-size:22px;font-weight:bold;border-top:1px solid #000;">
                                                            Description
