@{
    Layout = null;
    var flow = Context.Request.Query["flow"].ToString();
    var isUpdatePassword = flow.Equals("UpdatePassword", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expert Insured Accounting</title>
    <link rel="shortcut icon" type="images/x-icon" href="~/images/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/login.css" rel="stylesheet" />
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/utility.js" asp-append-version="true"></script>
    <script src="~/js/login.js"></script>
    <style>
        .account-logo {
            color: #5F2EE5 !important;
            font-size: 30px;
        }

        /* .login-card-content{
            min-height:50% !important;
            padding : 0 !important;
        } */

        .containerbody {
            min-height: 0 !important;
        }
    </style>
</head>

<body>

    <div class="ei-l-outer" data-name="LoginContainer" data-flow="@(isUpdatePassword ? "UpdatePassword" : "")">
        <div class="box-container" >
            <div class="card-box">
                <div class="card-body">
                    <div style="margin-top: 0; margin-bottom: 30px; text-align: center;">
                        <span class="account-logo"><img src="~/images/ei-accounting-logo.svg" height="45" title="EI-Accounting" /></span>
                    </div>
                    <div id="loginSection" class="@(isUpdatePassword ? "d-none" : "")">
                        @Html.Partial("_Login.cshtml")
                    </div>

                    <div id="forgotPasswordSection" class="@(isUpdatePassword ? "" : "d-none")">
                        @if (isUpdatePassword)
                        {
                            <div data-name="Containerbody" class="containerbody"></div>
                        }
                        else
                        {
                            @Html.Partial("ForgotPassword.cshtml")
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal" data-name="ModalMessage" tabindex="-1" style="z-index:1200;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-name="ModalMessageTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p data-name="ModalMessageBody"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-name="ModalMessageOk" data-bs-dismiss="modal">Ok</button>
                </div>
            </div>
        </div>
    </div>
    <div class="classic-spinner invisible" data-name="PartialPanelLoader">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <script>
        sessionStorage.removeItem('selectedDashboardTab');
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>