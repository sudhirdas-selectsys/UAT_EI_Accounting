@model Users;
@{
    var userData = ViewBag.data;
}
<script>
    $(document).on('click', '[data-name="formSubmit"]', function (e) {
        e.preventDefault();
        var form = $(this).closest('[data-name="form"]');
        var password = form.find('input[name="Password"]').val();
        var confirmPassword = form.find('input[name="ConfirmPassword"]').val();
        if (!password || !confirmPassword) {
            appCommon.ShowMessageModal("Password and Confirm Password are required.");
            return;
        }
        if (password !== confirmPassword) {
            appCommon.ShowMessageModal("Password and Confirm Password do not match.");
            return;
        }
        if (password.length < 8) {
            appCommon.ShowMessageModal("Password must be at least 8 characters.");
            return;
        }
        if (appCommon.IsValidForm(form)) {
            appCommon.SubmitForm(form, function (response) {

                if (response && response.Status) {
                       appCommon.ShowMessageModal('Password Updated Successfully!','Success');
                       window.location.href = '/Login/Index';
                }
                else {
                    appCommon.ShowMessageModal("Unable to process the request.");
                }

            }, "/Login/NewPassword", true, false);
        }
    });
</script>

<div id="Containerbody">
    <p class="h5 mb-2 text-center">Reset Your Password</p>
    <p class="mb-3 text-muted op-7 fw-normal text-center">Please enter and confirm your new password below.</p>
    <div>
        <form data-name="form">
            <div class="mb-3">
                <input type="hidden" value="@userData.Username" name="Username" />
                <label class="form-label">New Password</label>
                <input type="password" data-val="true" name="Password" class="form-control" autocomplete="off">
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" data-val="true" name="ConfirmPassword" class="form-control" autocomplete="new-password">
            </div>
            <button type="button" data-name="formSubmit" name="submit" class="btn btn-primary w-100">Submit</button>
        </form>
    </div>
</div>
