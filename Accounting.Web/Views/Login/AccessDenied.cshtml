
@model Users;
@{
    ViewData["Title"] = "Access Denied";
    Layout = "";
}
<style>
    body {
        font-family: Plus Jakarta Sans,sans-serif;
        font-size: 14px;
        background: #f5f5f5;
    }

    .error-content {
        background: #fff;
        max-width: 650px;
        text-align: center;
        margin: 0 auto;
        padding: 24px;
        border-radius: 15px;
        border: 1px solid #e2e2e2;
    }

    .forbidden img {
        margin: 0 auto 10px;
        display: block;
        width: 360px;
    }

    .error-content h3 {
        font-size: 24px;
        margin-top: 10px;
        margin-bottom: 4px;
        font-weight: 600;
    }

    .error-content p {
        max-width: 520px;
        font-size: 14px;
        font-weight: 500;
        line-height: 30px;
        margin: 0 auto;
        color: rgba(0, 0, 0, 0.5);
    }

    @@media(max-width:767px) {
        .error-content {
            width: 100%
        }

        .forbidden img {
            width: 80%
        }

        .error-content h3 {
            font-size: 20px;
        }

        .error-content p {
            line-height: 1;
            margin-bottom: 15px;
            margin-top: 15px;
        }
    }
</style>
<div class="mb-4 text-center mt-5">
</div>

<div class="forbidden error-content">
     <img src="~/images/sign-in-error-v2.svg" />
    <h3>403 Access Denied/Forbidden !</h3>
    <p>You don't have permission to access this resource.</p>
</div>

