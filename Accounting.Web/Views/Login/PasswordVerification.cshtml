@model Accounting.Web.Models.OtpViewModel
@{
    var otpType = (Model?.OtpType ?? "").ToString();
    var userEmail = (Model?.UserEmail ?? "your email");
    var userPhone = (Model?.UserPhone ?? "your phone");
    var error = Model?.ErrorMessage;
}
@{
    Layout = null;
}
<div>

    <p class="h5 mb-2 text-center">Password Verification</p>

    @if (otpType == "Email")
    {
        <p class="text-center text-muted">
            Thanks for keeping your account secure.
            Check your email:
            <strong>@CommonUtility.MaskEmailFixed(userEmail)</strong>
        </p>
    }

    @if (otpType == "Phone")
    {
        <p class="text-center text-muted">
            Check your mobile device:
            <strong>@userPhone</strong>
        </p>
    }

    <div class="v-code-block">

        <p class="text-center mb-3">
            <span id="counterTextPasswordVerification">
                You can request new OTP in:
                <strong>
                    <span data-name="OtpTimerPasswordVerification">20</span> Sec
                </strong>
            </span>

            <a href="javascript:void(0)"
               id="btnResendOtpPasswordVerification"
               class="d-none"
               data-name="btnResendOtpPasswordVerification"
               data-method="@otpType">
                Resend OTP
            </a>
        </p>

        <form data-name="formverifyotppasswordverification">

            @Html.AntiForgeryToken()

            <input type="hidden" name="otp" data-name="OtpPasswordVerification" />

            <input type="hidden"
                   name="Method"
                   value="@otpType" />

            <div class="v-code">
                <input type="text" name="d1" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
                <input type="text" name="d2" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
                <input type="text" name="d3" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
                <input type="text" name="d4" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
                <input type="text" name="d5" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
                <input type="text" name="d6" class="otp-input form-control text-center" maxlength="1" data-val-type="number">
            </div>

            <div class="actions mt-4">

                <button type="submit"
                        class="btn btn-primary w-100"
                        data-name="verifyotppasswordverification">
                    Verify OTP
                </button>

                <a href="/Login/Index">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<style>
    .card-body {
        padding: 25px;
    }

    .v-code .form-control {
        height: 35px;
        width: 35px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }

    .custom-check {
        display: flex;
        align-items: center;
        margin-top: 24px;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 100px;
        justify-content: space-between;
        margin-top: 36px;
    }
</style>