@{
    Layout = null;
}

<div data-name="Containerbody" class="containerbody">
    <p class="h5 mb-2 text-center">Forgot/Update Your Password?</p>
    <p class="mb-3 text-muted op-7 fw-normal text-center">Enter your User Name to Update your password.</p>
    <div data-name="formContainer">
        <form data-name="form">
            <div>
                <label for="Username" class="form-label">Username</label>
                <input type="text" data-val="true" name="Username" class="form-control">
            </div>

            <div class="actions">
                <button type="button" class="btn btn-primary w-100 continue" data-name="formSubmitPassword">Submit</button>
                <a href="javascript:void(0);" id="cancelForgetPassword"> Cancel </a>
            </div>
        </form>
    </div>
</div>
<style>
    .containerbody {
        min-height: 0 !important;
    }
</style>