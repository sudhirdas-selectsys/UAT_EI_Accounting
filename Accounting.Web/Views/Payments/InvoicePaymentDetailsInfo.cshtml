<div class="modal-footer" style="position: sticky; bottom: 0; background-color: #fff;">
	<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
</div>

<style>
	.pd-table-scroll {
		height: 100%;
		overflow-y: auto;
	}

	.ei-ac-db-table thead tr th:last-child, .ei-ac-db-table thead tr td:last-child {
		width: auto;
	}

	.invoicepaymentsheader-label {
		display: flex;
		align-items: center;
		font-size: 16px;
		font-weight: 600;
		color: #333;
	}

		.invoicepaymentsheader-label::after {
			content: "";
			flex: 1;
			height: 1px;
			background-color: #ddd;
			margin-left: 10px;
		}

	.arr-data-table th {
		white-space: nowrap;
	}
</style>