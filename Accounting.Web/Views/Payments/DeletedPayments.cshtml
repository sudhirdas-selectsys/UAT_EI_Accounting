@model List<Payments>
@{
	var PageSize = ViewBag.PageSize;
	var PageIndex = ViewBag.PageIndex;
	var TotalRecords = ViewBag.TotalRecords;
}

<div class="position-relative" style="margin-bottom:30px;">
	<div class="border">
		<div class="table-responsive table-scroll mb-2" style="max-height:340px; overflow-y:auto;">
			<table class="table ei-table mb-3 no-wrap ei-ac-db-table trns-db-table payment-valign">
				<thead>
					<tr>
						<th style="width:100px;">Payment Id</th>
						<th style="width:120px;">Entity Type</th>
						<th>Entity Name</th>
						<th>Payment Date</th>
						<th>Amount</th>
						<th>Remaining Amount</th>
						<th>Payment Type</th>
						<th>Reference Number</th>
						<th>Payment Status</th>
						<th>Bank Account</th>
						<th>Payment Direction</th>
			
					</tr>
				</thead>
				<tbody id="line-items-body">
					@if (Model?.Count > 0)
					{
						foreach (var item in Model)
						{
							<tr>
								<td>@item.Payment_Id</td>
								<td style="width: 100px;">
									<div class="text-truncate" title="@LookupUtility.GetAllEntityTypes().FirstOrDefault(c => c.EntityType_Id == item.EntityType_Id)?.Name">@LookupUtility.GetAllEntityTypes().FirstOrDefault(c => c.EntityType_Id == item.EntityType_Id)?.Name</div>
								</td>
								<td><div class="text-truncate" title="@item.EntityName">@item.EntityName</div></td>
								<td>@item.PaymentDate?.ToShortDateString()</td>
								<td>@CommonUtility.ConvertToCurrencyFormat(item.Amount, false, 2)</td>
								<td>
									<div class="@(item.RemainingAmount > 0 ? "tdRemainingAmountNotZero" : item.RemainingAmount == 0 ? "tdRemainingAmount" : "tdRemainingAmountLessZero")">@CommonUtility.ConvertToCurrencyFormat(item.RemainingAmount, false, 2)</div>
								</td>
								<td>@LookupUtility.GetAllPaymentTypes().FirstOrDefault(x => x.PaymentType_Id == item.PaymentType_Id)?.Name</td>
								<td><div class="text-truncate" title="@item.ReferenceNumber">@item.ReferenceNumber</div></td>
								<td>@LookupUtility.GetAllPaymentStatus().FirstOrDefault(x => x.PaymentStatus_Id == item.PaymentStatus_Id)?.Name</td>
								<td><div class="text-truncate" title="@LookupUtility.GetAllOperatingBanks().FirstOrDefault(x => x.OperatingBank_Id == item.OperatingBank_Id)?.Name">@LookupUtility.GetAllOperatingBanks().FirstOrDefault(x => x.OperatingBank_Id == item.OperatingBank_Id)?.Name</div></td>
								<td>
									@if (item.PaymentDirection_Id == MasterLookup._PaymentDirections.Incoming)
									{
										<i class="ri-arrow-down-line me-1"></i>
									}
									else
									{
										<i class="ri-arrow-up-line me-1"></i>
									}
		@LookupUtility.GetAllPaymentDirections().FirstOrDefault(x => x.PaymentDirection_Id == item.PaymentDirection_Id)?.Name
								</td>								
							</tr>
						}
					}
					else
					{
						<tr><td colspan="12">No records found!</td></tr>
					}
				</tbody>


			</table>
		</div>
	</div>
	
</div>
<style>
	[data-name="DashboardTabsContainer"] {
		min-height: 590px !important;
		/* max-height: 590px !important; */
	}

	.th-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.payment-valign tr th {
		vertical-align: middle;
		max-width:unset;
		white-space: nowrap;
		padding-bottom:8px;
		padding-top:8px;
	}

	.table-scroll {
		height: calc(100vh - 375px) !important;
	}


	.text-bg-primary {
		background-color: #eaffeb !important;
		color: #333 !important
	}
</style>