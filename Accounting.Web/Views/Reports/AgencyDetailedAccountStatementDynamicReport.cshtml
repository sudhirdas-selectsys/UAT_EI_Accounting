                                    var displayAgencyNetDue = TotalDueAmount < 0
                                    ? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalDueAmount), false, 2)})"
                                    : CommonUtility.ConvertToCurrencyFormat(TotalDueAmount, false, 2);
                                }
                                @displayAgencyNetDue
                                @* {{TotalNetDue}} *@
                            </div>
                        </td>
                        <td align="right"></td>
                    </tr>
                </tbody>
            </table>

            @if (counter == Model[0].DataTable.Rows.Count)
            {
                <!-- Spacer -->
                <table cellpadding="0" border="0" cellspacing="0" width="100%">
                    <tr>
                        <td height="20" class="p-0"></td>
                    </tr>
                </table>
                <!-- Final Warning -->
                <table class="agency-billed-table" cellpadding="0" border="0" cellspacing="0" width="100%">
                    <tr>
                        <td align="center">
                            <div class="due-date-alert">
                                ITEMS NOT PAID BY DUE DATE MAY BE CANCELLED BY THE CARRIER WITHOUT FURTHER WARNING
                            </div>
                        </td>
                    </tr>
                </table>
                <!-- Spacer -->
                <table cellpadding="0" border="0" cellspacing="0" width="100%">
                    <tr>
                        <td height="10" class="p-0"></td>
                    </tr>
                </table>
            }
            else
            {
                <div class="page-break"></div>


            }
            counter++;
        }
    }

}

