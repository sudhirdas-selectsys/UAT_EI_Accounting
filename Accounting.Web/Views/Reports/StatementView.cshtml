@model List<ReportOutputTables>
@using Newtonsoft.Json
@{
    Layout = null;
    var Report_Id = ViewBag.Report_Id;
    var FileType_Id = ViewBag.FileType_Id;
    var agentDetailIds = new List<long>();
    if (Model != null && Model.Count > 0 && Model[0].DataTable != null)
    {
        foreach (System.Data.DataRow row in Model[0].DataTable.Rows)
        {
            if (row["AgentReference_Id"] != DBNull.Value)
            {
                agentDetailIds.Add(Convert.ToInt64(row["AgentReference_Id"]));
            }
        }
    }
}
@{
    var ReportHTMLWithTemplate = ViewBag.ReportHTMLWithTemplate != null ? ViewBag.ReportHTMLWithTemplate : string.Empty;
    var ReportTemplate = ViewBag.ReportTemplate != null ? (LU_ReportTemplates)ViewBag.ReportTemplate : null;
}
<div data-name="StatementReportView">

    @if (Model != null && Model.Count > 0)
    {
        @if (Model?[0]?.DataTable?.Rows.Count > 0)
        {

        }
        @if (ReportTemplate == null)
        {
            if (Model?.Count > 1)
            {
                int tableSquence = 0;
                <ul class="nav nav-tabs" id="myTabReportstables" role="tablist">
                    @foreach (var ROT in Model.OrderBy(c => c.TableIndex))
                    {
                        <li class="nav-item @(tableSquence == 0 ? "active" : "")" role="presentation">
                            <button class="nav-link @(tableSquence == 0 ? "active" : "")" data-bs-toggle="tab" data-bs-target="#ReportTabPane_@($"{ROT.ReportOutputTable_Id}")" type="button" role="tab" aria-controls="reports-table-one-tab-pane" aria-selected="false" tabindex="-1">@(ROT.Name)</button>
                        </li>
                        tableSquence++;
                    }
                </ul>
                <div class="tab-content" id="myTabReportstablesContent">
                    @{
                        tableSquence = 0;
                    }
                    @foreach (var ROT in Model.OrderBy(c => c.TableIndex))
                    {
                        <div class="tab-pane fade @(tableSquence==0?"active show":"")" id="ReportTabPane_@($"{ROT.ReportOutputTable_Id}")" role="tabpanel" aria-labelledby="reports-table-tab-pane" tabindex="0" style="padding:10px;">
                            @Html.Partial("ReportTableItem", ROT)
                        </div>
                        tableSquence++;
                    }
                </div>
            }
            else
            {
                @Html.Partial("ReportTableItem", Model[0])
            }
        }
        else
        {
            @Html.Raw(ReportHTMLWithTemplate)
        }
    }
</div>
<input type="hidden" id="Report_Id" value="@ViewBag.Report_Id" />
<input type="hidden" id="SQLInputParameters" value='@Html.Raw(ViewBag.SQLInputParameters)' />
<input type="hidden" id="AgentDetailIds" value='@JsonConvert.SerializeObject(agentDetailIds)' />
@{
    var ActionType = ViewBag.ActionType != null ? ViewBag.ActionType.ToString() : "Sync";
}

<div class="position-sticky bottom-0 bg-white border-top text-end p-2">
    @if (ActionType == "Email")
    {
        <button type="button" data-name="btnSendEmail" class="btn btn-primary">
            Send Statement to Email
        </button>
    }
    else
    {
        <button type="button" data-name="btnSync" class="btn btn-primary">
            Sync Statement to EI
        </button>
    }
</div>

<div class="modal fade" id="inputModal" tabindex="-1" aria-labelledby="inputModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="max-width:500px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="inputModalLabel">Enter the Email details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-3">
                    <label for="txtEmailSub" class="form-label">Email Subject:</label>
                    <input type="text" id="txtEmailSub" class="form-control" required />
                </div>
                <div class="form-group mb-3">
                    <label for="txtEmailMsg" class="form-label">Email Message:</label>
                    <textarea id="txtEmailMsg" class="form-control" rows="4" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitEmailDetails" class="btn btn-success">Submit</button>
            </div>
        </div>
    </div>
</div>
<style type="text/css">


    td {
        word-wrap: break-word;
        white-space: normal;
    }
</style>
<script type="text/javascript">
	$(document).ready(function ()
	{
		$('[data-name="btnSync"]').click(function () {

            var FileType_Id= @FileType_Id;
            var actionType = $('#ActionType').val();
			appCommon.SubmitForm(ExistingForm, function (response) {
				if (typeof response != "undefined" && response != null && response.Status)
				{
					if (response.Status)
					{
						appCommon.ShowMessageModal("Documents Exported Successfully.","Success");
                    }
					else
					{
						if (response.Message != null && response.Message != '')
						{
                            appCommon.ShowMessageModal(response.Message);
                        }
						else
						{
							appCommon.ShowMessageModal("Error Exporting Documents","Failed");
                        }
                    }
                }
				else
				{
					appCommon.ShowMessageModal("Error Exporting Documents/No Documents Available","Failed");
                }
            }, "/Reports/EIBrokerStatementUpload?Report_Id=" + Report_Id + "&FileType_Id=" + FileType_Id + "&ActionType=" + encodeURIComponent(actionType), true);
            return false;
        });


		$('[data-name="ReportTablePanel"]').each(function (p, panel) {
            var tableOffset = $('[data-name="ReportTablePanel"]').offset().top;
            $(panel).css("min-height", window.innerHeight - tableOffset);
            $(panel).css("max-height", window.innerHeight - tableOffset);
        });
        $(document).off('click.sendAgentEmail', '[data-name="btnSendEmail"]').on('click.sendAgentEmail', '[data-name="btnSendEmail"]', function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            console.log("SEND EMAIL BUTTON CLICKED");
            var $button = $(this);
               
            // Prevent multiple clicks while request is in progress
            if ($button.prop('disabled')) {
                return false;
            }

            var agentDetailIds = $('#AgentDetailIds').val();
            var reportId = $('#Report_Id').val();
            var sqlInputParameters = $('#SQLInputParameters').val();
           
            console.log("AgentDetailIds:", agentDetailIds);
            console.log("Report_Id:", reportId);
            console.log("SQLInputParameters:", sqlInputParameters);

            if (!agentDetailIds || agentDetailIds === '[]') {
                appCommon.ShowMessageModal("No agency details available.", "Failed");
                return false;
            }

          appCommon.ShowConfirmationModal("Do you want to update the default email template?", "Confirmation!",
          function () {
            $('#txtEmailSub').val('');
            $('#txtEmailMsg').val('');
            $('#inputModal').modal('show');
          },
          function () {
            sendAgentStatementEmail($button, agentDetailIds, reportId, sqlInputParameters, null, null);
          }
    );

    return false;
        });


        $(document).off('click.confirmSubmitEmail', '#btnSubmitEmailDetails').on('click.confirmSubmitEmail', '#btnSubmitEmailDetails', function(e) {
        e.preventDefault();

        var $mainBtn = $('[data-name="btnSendEmail"]');
        var emailSubject = $('#txtEmailSub').val();
        var emailMessage = $('#txtEmailMsg').val();
        var agentDetailIds = $('#AgentDetailIds').val();
        var reportId = $('#Report_Id').val();
        var sqlInputParameters = $('#SQLInputParameters').val();

        if (!agentDetailIds || agentDetailIds === '[]') {

            appCommon.ShowMessageModal(
                "No agency details available.",
                "Failed"
            );

            return false;
        }

        // Close customization modal
        $('#inputModal').modal('hide');

        // Send customized email
        sendAgentStatementEmail($mainBtn, agentDetailIds, reportId, sqlInputParameters, emailSubject, emailMessage);

        return false;
    });
        function sendAgentStatementEmail($button, agentDetailIds, reportId, sqlInputParameters, emailSubject, emailMessage) {

        $button.prop('disabled', true);
        $button.data('original-text', $button.text());
        $button.text('Sending...');

        var requestData = {
            AgentDetailIds: agentDetailIds,
            Report_Id: reportId,
            SQLInputParameters: sqlInputParameters,
            EmailSubject : emailSubject,
            EmailBody : emailMessage
        };

        $.ajax({
            type: "POST",
            url: "/Reports/EIAgentStatementEmail",
            data: requestData,
            success: function(response) {
                console.log("SUCCESS RESPONSE:", response);
                if (response && response.Status) {
                        appCommon.ShowMessageModal("Email sent successfully.", "Success");                  
                }
                else {

                    appCommon.ShowMessageModal(
                        response?.Message ||
                        "Error sending statement.",
                        "Failed"
                    );
                }
            },

            error: function(xhr, status, error) {
                console.log("AJAX ERROR");
                console.log("Status Code:", xhr.status);
                console.log("Status:", status);
                console.log("Error:", error);
                console.log("Response:", xhr.responseText);

                appCommon.ShowMessageModal(
                    "HTTP " + xhr.status + ": " +
                    (xhr.responseText || error),
                    "Failed"
                );
            },
            complete: function() {
                $button.prop('disabled', false);

                var originalText =
                    $button.data('original-text') ||
                    'Send Statement to Email';
                $button.text(originalText);
            }
        });
        return false;
    }
    });
</script>