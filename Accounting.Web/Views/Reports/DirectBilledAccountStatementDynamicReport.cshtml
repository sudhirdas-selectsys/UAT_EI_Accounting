																								}
																								@TotalDisplayCommsNetDue
																							</div>
																						</td>
																					}
																					<!-- Column 8: Comm. Paid to Date - TOTAL (Simplified Only) -->
																					<td class="border-top-1 border-bottom-1" align="right"></td>
																					<!-- Column 9: Comm. Due - TOTAL (Your existing code) -->
																					@if (IsSimplifiedView)
																					{
																						<td class="border-top-1 border-bottom-1" align="right">
																							<div class="fw-medium border-top-dark pt-8">
																								@{
																									TotalCommsNetDue = invoiceDetailsList.Sum(r => r.Field<double>("Comm. Due"));
																									double RoundedDue = Math.Round(TotalCommsNetDue, 2);
																									string TotalDisplayCommsNetDue = (RoundedDue == 0.00)
																									? "$0.00"
																									: (RoundedDue < 0
																									? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(RoundedDue), false, 2)})"
																									: CommonUtility.ConvertToCurrencyFormat(RoundedDue, false, 2));
																								}
																								@TotalDisplayCommsNetDue
																							</div>
																						</td>
																					}
																				</tr>

																			}
																		}
																		catch (Exception ex)
																		{

																			throw;
																		}
																	}

																}

															}
														}

													</tbody>
												</table>
												<table style="position:absolute;bottom:0;" width="97.5%">
													<tbody>
														@{
															var invoiceDetailList = Model[1].DataTable.AsEnumerable().Where(r => r.Field<string>("PolicyNumber").Trim() == agencyPolicy["PolicyNumber"].ToString().Trim());

															//agencyPolicy["CarrierName"].ToString();
															//agencyPolicy["InsuredName"].ToString();
															if (invoiceDetailList.Any())
															{
																var policyRow = invoiceDetailList.FirstOrDefault();
																long policyDetailsId = policyRow.Field<long>("Id");
																var invoiceList = Model[3].DataTable.AsEnumerable().Where(r => r.Field<long>("PolicyDetails_Id") == policyDetailsId);
																var invoiceIds = invoiceList.GroupBy(r => r.Field<string>("PolicyNumber")).Select(g => g.Key);
																foreach (var invoiceId in invoiceIds)
																{
																	//var invoiceDetailsList = Model[3].DataTable.AsEnumerable().Where(r => r.Field<string>("PolicyNumber") == invoiceId);

																	var invoiceDetailsList = Model[3].DataTable.AsEnumerable()
																	.Where(r => r.Field<string>("PolicyNumber") == invoiceId
																	&& r.Field<string>("Carrier") == agencyPolicy["CarrierName"].ToString()
																	&& r.Field<string>("Insured Name") == agencyPolicy["InsuredName"].ToString());

																	DataTable tempinvoiceDetailsList = null;
																	if (invoiceDetailsList.Any())
																	{
																		tempinvoiceDetailsList = invoiceDetailsList.CopyToDataTable();
																	}
																	else
																	{
																		tempinvoiceDetailsList = Model[3].DataTable.Clone(); // returns empty table with same schema
																	}

																	int rowCount = invoiceDetailsList.Count();
																	if (rowCount > 0)
																	{
																		<tr>
																			<td align="left" class="border-top-1">
																				<span class="fw-semibold">Balance Due</span>
																			</td>
																			<td class="border-top-1" width="18%"></td>
																			<td class="border-top-1" align="right" width="12%">
																				@*<div class="fw-medium border-top-dark pt-8">

                                @{
                                double TotalNetAmount = invoiceDetailsList.Sum(r => r.Field<double>("NetAmount"));
                                var TotalDisplayNetAmount = TotalNetAmount < 0 ? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalNetAmount), false, 2)})" : Convert.ToString(CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalNetAmount), false, 2));
                                }
                                @TotalDisplayNetAmount
                                </div>*@
																			</td>
																			<td class="border-top-1" align="right" width="12%">
																				@*  Add Premium Collected  *@
																				@*@{
                                double TotalPremiumCollected = invoiceDetailsList.Sum(r => r.Field<double>("InferredPremiumCollected"));
                                var TotalDisplayPremiumCollected = TotalPremiumCollected < 0 ? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalPremiumCollected), false, 2)})" : Convert.ToString(CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalPremiumCollected), false, 2));
                                }
                                @TotalDisplayPremiumCollected*@
																			</td>
																			<td class="border-top-1" align="right" width="12%">
																				@*<div class="fw-medium border-top-dark pt-8">
                                @{
                                double TotalAgentCommission = invoiceDetailsList.Sum(r => r.Field<double>("AgentCommPercentage"));
                                var TotalDisplayAgentCommission = TotalAgentCommission < 0
                                ? $"({Math.Abs(TotalAgentCommission).ToString("0.00")} %)"
                                : $"{TotalAgentCommission.ToString("0.00")} %";

                                }
                                @TotalDisplayAgentCommission
                                </div>*@
																			</td>
																			<td class="border-top-1" align="right" width="12%">
																				<div class="fw-medium border-top-dark pt-8">
																					@{
																						//if (invoiceDetail["LineItemDescription"])
																						// double TotalCommsNetDue = invoiceDetailsList
																						// .Where(r => r.Field<string>("LineItemDescription") != "Comm. Paid")
																						// .Sum(r => r.Field<double>("CommsNetDue"));

																						@if (!IsSimplifiedView)
																						{
																							TotalCommsNetDue = invoiceDetailsList.Sum(r => r.Field<double>("CommsNetDue"));
																						}
																						else
																						{
																							TotalCommsNetDue = invoiceDetailsList.Sum(r => r.Field<double>("Comm.") - Convert.ToDouble(r.Field<decimal>("Comm. Paid to Date")));
																						}
																						//double TotalCommsNetDue = invoiceDetailsList.Sum(r => r.Field<double>("Comm.") - Convert.ToDouble(r.Field<decimal>("Comm. Paid to Date")));
																						//var TotalDisplayCommsNetDue = TotalCommsNetDue < 0 ? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalCommsNetDue), false, 2)})" : Convert.ToString(CommonUtility.ConvertToCurrencyFormat(Math.Abs(TotalCommsNetDue), false, 2));
																						double RoundedDue = Math.Round(TotalCommsNetDue, 2);
																						var TotalDisplayCommsNetDue = (RoundedDue == 0.00)
																						? "$0.00" // no parentheses if zero or negative zero
																						: (RoundedDue < 0
																						? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(RoundedDue), false, 2)})" // parentheses if negative and not zero
																						: CommonUtility.ConvertToCurrencyFormat(RoundedDue, false, 2)); // normal display if positive
																					}
																					@TotalDisplayCommsNetDue
																				</div>
																			</td>
																		</tr>
																	}
																}

															}
														}
													</tbody>
												</table>
											</td>
										</tr>
										<tr><td height="12" class="p-0"></td></tr>
									}
								}
								@if (!IsSimplifiedView)
								{
									AgencyCommsNetDueTotal += PolicyCommsNetDueTotal;
								}
								else
								{
									AgencyCommsNetDueTotal += TotalCommsNetDue;
								}
							}
						}
					}
				</table>
			</div>
			if (isInvoicesExist)
			{
				<table width="100%" class="fs-12 lh-18 pd-table" cellpadding="0" border="0" cellspacing="0">
					<tbody>
						<tr>
							<td rowspan="2" style="width:200px;">
								<div><span class="fw-semibold fs-14">Comm. Net Due Total</span></div>
							</td>
							<td colspan="6"></td>
							<td class="fw-semibold fs-14" align="right">NET DUE</td>
							<td></td>
						</tr>
						<tr>
							<td class="fw-400" colspan="6"></td>
							<td class="fw-semibold fs-14 pt-0 pb-0" align="right">
								<div class="pt-8 pb-8" style="border-top:4px solid #000; border-bottom:4px solid #000; width:100px;">
									@{
										var agencyNetDueDisplay = AgencyCommsNetDueTotal < 0
										? $"({CommonUtility.ConvertToCurrencyFormat(Math.Abs(AgencyCommsNetDueTotal), false, 2)})"
										: CommonUtility.ConvertToCurrencyFormat(AgencyCommsNetDueTotal, false, 2);
									}
									@agencyNetDueDisplay
									@* {{TotalNetDue}} *@
								</div>
							</td>
							<td align="right"></td>
						</tr>
					</tbody>
				</table>
				<table width="100%">
					<tr>
						<td style="text-align:center; background-color:white;padding:3px 12px;font-weight:normal; font-size:18px; color:red; border:dashed 2px red">
							<strong>Total Commission due to Agency this Month</strong>
						</td>
					</tr>
					<tr><td height="12" class="p-0"></td></tr>
				</table>
				@if (counter < Model[0].DataTable.Rows.Count @* - 1 *@ )
				{
					<div class="page-break"></div>
				}
			}
			counter++;
		}


	}


