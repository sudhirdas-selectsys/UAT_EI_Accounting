<!-- ... report markup ... -->
<script>
	function processInvoiceRows() {
		$(".policy-block").each(function (blockIndex, block) {
			var invoiceRows = $(block).find("tr.invoiceIdList");
			if (invoiceRows.length === 0) {
				$(block).hide();
				$(block).prev("table").hide();
			} else {
				$(block).show();
				$(block).prev("table").show();
			}
		});
	}

	$(document).ready(function () {
		processInvoiceRows();

		$(document).on("click", "[data-name='btnLoadReport']", function () {
			processInvoiceRows();
		});
	});
</script>





