@model List<Reports>
@{
	ViewData["Title"] = "Reports";
	long DefaultReport_Id = ViewBag.Report_Id;
	ViewBag.Reports = Model;
	var DefaultReport_Name = "Reports";
	var PageSize = ViewBag.PageSize;
	var PageIndex = ViewBag.PageIndex;
	var TotalRecords = ViewBag.TotalRecords;

}
@if (Model != null && Model.Count > 0)
{
	if (DefaultReport_Id == 0)
		DefaultReport_Id = Model.OrderBy(c => c.Sequence).Select(c => c.Report_Id).FirstOrDefault();
	if (DefaultReport_Id > 0)
	{
		DefaultReport_Name = Model.First(c => c.Report_Id == DefaultReport_Id).Name;
	}
	<div data-name="ReportsContainer">
		<div class="d-flex card" style="height: calc(100vh - 120px);">
			<!-- Flex container to align left and right side-by-side -->
			<!-- Left Panel -->
			<div class="policy-menu" style="padding-right:0px">
				<!-- Set a fixed width or use col-* -->
				<div class="policy-menu-heading toggle-menu-btn-lob" style="cursor:pointer;z-index:9">
					<i class="ri-arrow-left-double-line me-0"></i>
				</div>
				<div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical" data-name="divChartOfAccountsMenu">
					<div class="collapse show general-menu" id="reportSubmenu" data-name="navReportsMainMenu" style="height: calc(100vh - 136px);overflow-y: auto; overflow-x: hidden;padding-right: 0px;">
						@Html.Partial("ReportNavigationItem", Model)
					</div>
				</div>
			</div>
			<!-- Right Panel -->
			<div class="card-body flex-grow-1">
				<!-- flex-grow-1 allows it to take the remaining space -->
				<div class="row" id="tabReports">
					<div class="w-100 pb-2">
						<div class="row">
							<div class="col-12">
								<div class="py-3 ps-2">
									<div>
										<div data-name="ReportForm"></div>
										<div data-name="ReportView"></div>
									</div>
								</div>

							</div>
						</div>

					</div>
				</div>
			</div>

		</div>

	</div>
	<script type="text/javascript">
		var DefaultReport_Id = parseInt('@DefaultReport_Id');
	</script>
}
<script src="~/js/reports/report.js" asp-append-version="true"></script>
<script src="~/js/reports/reportform.js" asp-append-version="true"></script>
<link href="~/css/reports/reports.css" rel="stylesheet" asp-append-version="true" />
<script>
	$(function () {
		if ($('[data-name="divReportsMenu"]').is(':visible')){
			$('[data-tab-name="btnGetReports"]').trigger('click');
		}
		var sample = '<p class="text-center">You don’t have access to manage any configurations at this time. Contact admin.</p>';
		var visibleNavPills = $('.nav-pills:visible');
		if (visibleNavPills.length === 0) {
			$('[data-name="ReportsTabContainer"]').html(sample);
		} else {
			$('[data-name="ReportsTabContainer"]').empty();
		}

	});


</script>
