    [data-name="divAccountsPayableGrid"] {
        min-height: auto !important;
        height: calc(100vh - 360px) !important;
        overflow-y: auto;
        padding-right: 4px;
    }

    .dropdown-menu {
        border: 1px solid #b9b2b2 !important;
