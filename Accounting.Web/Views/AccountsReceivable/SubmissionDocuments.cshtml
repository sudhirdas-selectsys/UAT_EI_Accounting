@model List<SubmissionDocuments>
@{
    ViewData["Title"] = "Submission Documents";
   var TransactionType = ViewBag.TransactionType;
}

<style>
    .doc-header {
        background-color: #f5f5f5;
        font-weight: 600;
    }

    .tab-custom .nav-link.active {
        background-color: #6f42c1;
        color: white;
    }

    .section-header {
        background-color: #eeeeff;
        padding: 10px;
        font-weight: bold;
    }

    .doc-table th {
        background-color: #d6d0f0;
    }

    .icon-btn {
        border: none;
        background: none;
        color: #6f42c1;
        font-size: 18px;
    }

        .icon-btn.delete {
            color: red;
        }


    .tab-custom .nav-link {
        color: #6f42c1;
        transition: all 0.2s ease;
        border: none;
        border-bottom: 3px solid transparent;
    }

        /* Default active tab */
        .tab-custom .nav-link.active {
            background-color: #6f42c1;
            color: white;
        }


        .tab-custom .nav-link:hover {
            background-color: #6f42c1;
            color: white;
        }


            .tab-custom .nav-link:hover ~ .nav-link.active,
            .tab-custom .nav-link.active:not(:hover):has(~ .nav-link:hover) {
                background-color: transparent;
                color: #6f42c1;
                border-bottom: 3px solid #6f42c1;
                border-radius: 0;
            }

    .document-title{
        max-width:150px;
    }
           
            
</style>

<div class="pb-3">   
   @*  <ul class="nav nav-tabs tab-custom">
        <li class="nav-item">
            <a class="nav-link active" href="#">Submission Documents</a>
        </li>
    </ul> *@
       

    
    <div class="mt-3 border">
        <div class="section-header d-flex justify-content-between">
            <span>
                @if (TransactionType == MasterLookup._EITransactionTypes.CAN)
                {
                    @($"***{TransactionType}")
                }
                else
                {
                    @TransactionType
                }
            </span>
        </div>
        <div class="table-responsive">
        <table class="table doc-table mb-0">
            <thead>
                <tr>
                   @*  <th style="width:40px;"> <input type="checkbox" /></th> *@
                    <th>Date</th>
                    <th>Doc Type</th>
                    <th>Title</th>
                    <th>LOB</th>
                    <th style="width:150px">Carrier</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var submissionDocument in Model)
                    {
                        <tr>
                           @*  <td><input type="checkbox" /></td> *@ 
                            <td>
                                @submissionDocument.DateCreated <br />
                                <small></small>
                            </td>
                            <td>
                                    <a href="javascript:void(0)"
                                        data-name="DownLoadFileDataPDF"
                                       data-filename="@submissionDocument.TypeDescription"
                                       data-dtd-document-id="@submissionDocument.DTDocumentID">
                                        <img src="https://cdn-icons-png.flaticon.com/16/337/337946.png" alt="PDF Icon" />
                                    @submissionDocument.TypeDescription
                                </a>
                            </td>
                            <td><a href="#" class="text-truncate d-block document-title" title="@submissionDocument.Title">@submissionDocument.Title</a></td>
                            <td>@submissionDocument.LOB</td>
                            <td class="text-truncate d-block document-title" title="@submissionDocument.CompanyName">@submissionDocument.CompanyName</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No Records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
</div>