    }

    .accordion-header .FinanceBadge,
    .accordion-header .FinanceNameBadge {
        width: 75px; /* right: 0px; */
        left: 20px;
        background-color: #e0e9fa;
        color: #5F2EE5;
        border-top-right-radius: 0;
        border-bottom-left-radius: 6px;
