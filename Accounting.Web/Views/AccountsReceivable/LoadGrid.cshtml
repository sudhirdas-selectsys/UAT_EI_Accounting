        transform: inherit;
        white-space: nowrap;
    }

    .invoice-data-view-item {
        flex: auto;
    }

        .invoice-data-view-item.me-3 {
            margin-right: 0 !important;
        }

    .label {
        display: inline-block !important;
        min-width: 160px;
        max-width: 100%
    }
</style>
<script>
    $(function(){
        $('[data-name="CollapseRows"]').css('display','');
        $('[data-name="ExpandRows"]').css('display','');
    })
</script>
