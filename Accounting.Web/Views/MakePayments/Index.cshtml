<script>
    $(document).ready(function () {

        // Flatpickr for From Date
        const fromPicker = flatpickr("#fromDate", {
            dateFormat: "m/d/Y",
            maxDate: "today",
            allowInput: false,
            clickOpens: true
        });

        // Flatpickr for To Date
        const toPicker = flatpickr("#toDate", {
            dateFormat: "m/d/Y",
            maxDate: "today",
            allowInput: false,
            clickOpens: true
        });

        // Open calendar when icon clicked
        $(".calendarIcon").on("click", function () {
            $(this).siblings("input").focus();
        });

           $('input[name="DateType"]').on('change', function () {

        const selectedValue = $(this).val();

        if (selectedValue === "Created") {

            // SP Value
            $("#InvoiceDate").val("InvoiceCreatedDate");

            // Labels
            $("#fromDateLabel").text("Created From Date:");
            $("#toDateLabel").text("Created To Date:");

            // Placeholder
            $("#fromDate").attr("placeholder", "Created From Date");
            $("#toDate").attr("placeholder", "Created To Date");

            // IMPORTANT
            $("#fromDate").attr("name", "InvoiceCreatedFromDate");
            $("#toDate").attr("name", "InvoiceCreatedToDate");

            // Remove effective names if any
            $("#fromDate").removeAttr("data-effective");
            $("#toDate").removeAttr("data-effective");
        }

        else if (selectedValue === "Effective") {

            // SP Value
            $("#InvoiceDate").val("InvoiceEffectiveDate");

            // Labels
            $("#fromDateLabel").text("Effective From Date:");
            $("#toDateLabel").text("Effective To Date:");

            // Placeholder
            $("#fromDate").attr("placeholder", "Effective From Date");
            $("#toDate").attr("placeholder", "Effective To Date");

            // IMPORTANT
            $("#fromDate").attr("name", "InvoiceEffectiveFromDate");
            $("#toDate").attr("name", "InvoiceEffectiveToDate");
        }
    });


    // Initial trigger
        $('input[name="DateType"]:checked').trigger('change');


    });
</script>
